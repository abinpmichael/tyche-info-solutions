<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---------------------------------------------------------------
    # Auto-detect environment and set the correct RewriteBase.
    #
    # LOCAL  (XAMPP):   RewriteBase /tyche-info-solutions/
    # LIVE   (cPanel):  RewriteBase /cms/
    # ---------------------------------------------------------------

    # ── LIVE SUBFOLDER ──────────────────────────────────────────────
    RewriteCond %{REQUEST_URI} ^/cms/ [NC]
    RewriteRule ^ - [E=BASE:/cms/]

    # ── LOCAL (XAMPP) ───────────────────────────────────────────────
    RewriteCond %{HTTP_HOST} ^localhost$ [NC]
    RewriteRule ^ - [E=BASE:/tyche-info-solutions/]

    # ── DEFAULT / LIVE ROOT ─────────────────────────────────────────
    RewriteCond %{ENV:BASE} ^$
    RewriteRule ^ - [E=BASE:/]

    # RewriteBase /
    
    # Remove index.php from URL
    RewriteCond %{THE_REQUEST} \s/+[^?]*index\.php[/\s?] [NC]
    RewriteRule ^(.*)index\.php(.*)$ %{ENV:BASE}$1$2 [R=301,NE,L]

    # Allow actual files and directories to load directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else through index.php
    RewriteRule ^(.*)$ %{ENV:BASE}index.php/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 /index.php
</IfModule>
